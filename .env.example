# Copy to .env for Edge Functions and backup scripts. Do not commit the copy.
# Flutter never reads this file. The app only receives SUPABASE_URL,
# SUPABASE_PUBLISHABLE_KEY and SUPABASE_ENV through env.json.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
SUPABASE_ENV=local

# Edge Functions only. Never put these in Flutter, env.json, or git.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SITE_URL=https://YOUR_APP_HOST

# Direct Postgres connection for pg_dump. Not an API key.
DATABASE_URL=
